    </div>

    <div class="user-info">
        <img src="user.jpg" alt="User Avatar" class="avatar" />
        <div>
            <p class="user-name">Juan</p>
            <p class="user-role">Super Admin</p>
        </div>
    </div>

    <nav class="nav-menu">
        <NavLink class="nav-item" href="/"><i class="bi bi-grid"></i> Dashboard</NavLink>
        <NavLink class="nav-item" href="/inventario"><i class="bi bi-box-seam"></i> Inventario</NavLink>
        <NavLink class="nav-item" href="/laboratorios"><i class="bi bi-box-seam"></i> Laboratorio</NavLink>
        <NavLink class="nav-item" href="/reportes"><i class="bi bi-bar-chart"></i> Reportes</NavLink>
        <NavLink class="nav-item" href="/reporteVentas"><i class="bi bi-bar-chart"></i> Reporte de Ventas</NavLink>
        <NavLink class="nav-item" href="/reporteVentasLaboratorios"><i class="bi bi-bar-chart"></i> Reporte de Ventas Laboratorios</NavLink>
        <NavLink class="nav-item" href="/reporteVentasCategorias"><i class="bi bi-bar-chart"></i> Reporte de Ventas Categorias</NavLink>
        <NavLink class="nav-item" href="/facturacion"><i class="bi bi-file-earmark-text"></i> Facturación</NavLink>
        <NavLink class="nav-item" href="/compras"><i class="bi bi-bag-check"></i> Compras</NavLink>
    </nav>

