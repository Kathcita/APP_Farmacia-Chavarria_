<div class="sidebar @(isMenuOpen ? "open" : "")">
    <div class="sidebar-header">
        <img src="farmaciachavarialogo.png" alt="Logo" class="logo" />
        <h3>Farmacia Chavarria</h3>
    </div>

    <div class="user-info">
        <img src="user.jpg" alt="User Avatar" class="avatar" />
        <div>
            <p class="user-name">Juan</p>
            <p class="user-role">Super Admin</p>
        </div>
    </div>

    <nav class="nav-menu">
        <NavLink class="nav-item" href="/"><i class="bi bi-grid"></i> Dashboard</NavLink>
        <NavLink class="nav-item" href="/inventario"><i class="bi bi-box-seam"></i> Inventario</NavLink>
        <NavLink class="nav-item" href="/categorias"><i class="bi bi-box-seam"></i> Categorías</NavLink>
        <NavLink class="nav-item" href="/laboratorios"><i class="bi bi-box-seam"></i> Laboratorio</NavLink>
        <NavLink class="nav-item" href="/Proveedores"><i class="bi bi-box-seam"></i> Proveedores</NavLink>

        <div class="nav-item report-menu" @onclick="ToggleReportMenu" style="user-select:none;">
            <i class="bi bi-bar-chart"></i> Reportes
            <div class="space"></div>
            <i class="fa-solid @(showReports ? "fa-chevron-up" : "fa-chevron-down")"></i>
        </div>

        <div class="submenu @(showReports ? "show" : "")">
            <NavLink class="nav-item submenu-item" href="/reportesGenerales"><i class="bi bi-bar-chart"></i> Reportes Generales</NavLink>
            <NavLink class="nav-item submenu-item" href="/reporteVentas"><i class="bi bi-bar-chart"></i> Reporte de Ventas</NavLink>
            <NavLink class="nav-item submenu-item" href="/reporteVentasProducto"><i class="bi bi-bar-chart"></i> Reporte de Ventas Productos</NavLink>
            <NavLink class="nav-item submenu-item" href="/reporteVentasLaboratorios"><i class="bi bi-bar-chart"></i> Reporte de Ventas Laboratorios</NavLink>
            <NavLink class="nav-item submenu-item" href="/reporteVentasCategorias"><i class="bi bi-bar-chart"></i> Reporte de Ventas Categorias</NavLink>
            <NavLink class="nav-item submenu-item" href="/medicamentosEscasos"><i class="bi bi-bar-chart"></i> Medicamentos Escasos</NavLink>
            <NavLink class="nav-item submenu-item" href="/medicamentosPorCaducar"><i class="bi bi-bar-chart"></i> Medicamentos Por Caducar</NavLink>
        </div>

        <NavLink class="nav-item" href="/facturacion"><i class="bi bi-file-earmark-text"></i> Facturación</NavLink>
        <NavLink class="nav-item" href="/compra"><i class="bi bi-bag-check"></i> Compras</NavLink>
    </nav>

    <footer class="sidebar-footer">
        <small>Copy Right © 2025</small><br />
        <small>v1.12</small>
    </footer>
</div>

<button class="menu-toggle" @onclick="ToggleMenu">
    <i class="bi bi-list"></i>
</button>

@code {
    private bool isMenuOpen = false;
    private bool showReports = false;

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;
    private void ToggleReportMenu() => showReports = !showReports;
}

<style>
.sidebar {
    width: 280px !important;
    background-color: #283342;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    padding: 1rem 0;
    overflow-y: auto;
    transition: transform 0.3s ease;
    z-index: 1000;
    transform: translateX(-100%);
    box-shadow: 2px 0 5px rgba(0, 0, 0, 0.5);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    @@media (min-width: 768px) {
    .sidebar {
        transform: translateX(0);
        box-shadow: none;
    }

    .menu-toggle {
        display: none;
    }
    }

.sidebar-header {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #2f3b4c;
    background-color: #1D242E;
    margin-top: -15px;
    }

    .sidebar-header h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

.logo {
    width: 35px;
    height: 35px;
    margin-right: 0.75rem;
    border-radius: 8px;
}

.user-info {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #2f3b4c;
}

.avatar {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    margin-right: 1rem;
    border: 2px solid #0FC8CF;
}

.user-name {
    font-weight: bold;
    margin: 0;
}

.user-role {
    font-size: 0.8rem;
    color: #80ffaa;
    margin: 0;
}

.nav-menu {
    display: flex;
    flex-direction: column;
    padding: 0 1rem;
    flex: 1;
}

.nav-item {
    display: flex;
    align-items: center;
    padding: 0.75rem 0;
    color: #ffffff;
    text-decoration: none;
    transition: background-color 0.2s ease;
    cursor: pointer;
}

    .nav-item i {
        margin-right: 0.75rem;
        font-size: 1.1rem;
    }

    .nav-item:hover {
        background-color: #0FC8CF;
        border-radius: 8px;
        padding-left: 0.75rem;
    }

.report-menu {
    display: flex;
    justify-content: start;
    align-items: center;
    cursor: pointer;
}

.space {
    flex: 1;
}

.submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    flex-direction: column;
    padding-left: 1.5rem;
}

    .submenu.show {
        max-height: 500px;
    }

.submenu-item {
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: #c0d6d6;
}

    .submenu-item:hover {
        background-color: #0FC8CF;
        border-radius: 8px;
        padding-left: 0.75rem;
        color: white;
    }

.sidebar-footer {
    padding: 1rem;
    font-size: 0.75rem;
    color: #cccccc;
    margin-top: 40px;
    text-align: center;
    background-color: #1D242E;
    border-top: 1px solid #2f3b4c;
}

.menu-toggle {
    position: fixed;
    top: 1rem;
    left: 1rem;
    background-color: #1E2A38;
    color: white;
    border: none;
    padding: 0.5rem;
    border-radius: 6px;
    font-size: 1.5rem;
    z-index: 1100;
    cursor: pointer;
    display: block;
}
</style>
