            gap:10px;
        }

        .search-box{
            max-width: 100%;
        }
    }

    @@media(max-width: 768px){
            .page-controls {
        padding-top: 10px;
        padding-bottom: 10px;
    }

        .pagination{
            flex-direction:column;
        }

    .pagination span{
        text-align:center;
    }
    }
    </style >