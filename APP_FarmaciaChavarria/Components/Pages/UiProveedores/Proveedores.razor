@page "/Proveedores"
@using APP_FarmaciaChavarria.ViewModels.ProveedoresViewModel
@inject ProveedoresViewModel ViewModel
@inject NavigationManager Navigation

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventario - Proveedores</title>
    <link rel="stylesheet" href="styles.css" />
</head>

<body >
    @if (!string.IsNullOrWhiteSpace(ViewModel.MensajeError))
    {
        <div class="alert-error">
            <span>@ViewModel.MensajeError</span>
            <button @onclick="() => ViewModel.MensajeError = string.Empty">X</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ViewModel.MensajeExito))
    {
        <div class="alert-success">
            <span>@ViewModel.MensajeExito</span>
            <button @onclick="() => ViewModel.MensajeExito = string.Empty">X</button>
        </div>
    }

    <div class="container" >
        <div class="breadcrumb" >
            <strong> Inventario</strong> &rsaquo; <strong class="active"> Proveedores</strong>
        </div >
        <p class="subtitle" > Lista de Proveedores</p >
        <div class="top-bar">
            <div class="search-box">
                <input type="text" placeholder="Buscar Proveedores" @bind=ViewModel.BusquedaProvedor @onkeydown="ManejarTeclaEnter" />
                <button class="search-btn" @onclick="() => ViewModel.BuscarProveedor(1)"> 🔍</button>
            </div>
            <button class="add-btn" @onclick="() => NavegarAgregarProveedor()">
                <span>➕</span> Agregar Proveedores
            </button>
        </div>
        <table >
            <thead >
                <tr >
                    <th > Nombre del Proveedor</th >
                    <th > Teléfono </th >
                    <th > Acción</th >
                </tr >
            </thead >
            <tbody >
                @foreach (var prov in ViewModel.Proveedor)
                {
                    <tr >
                        <td> @prov.nombre </td>
                        <td> @prov.telefono </td>
                        <td > <a href="#" @onclick="() => NavegarActualizarProveedor(prov.id_proveedor)"> Ver detalles →</a > </td >
                    </tr >
                }
            </tbody >
        </table >

        <div class="pagination">
            <span>Mostrando 1 - @ViewModel.TamañoDePaginaProv resultados de @ViewModel.TotalDeproveedores</span>
            <div class="page-controls">
                <button class="nav-btn" @onclick="() => PaginaAnterior()">‹</button>
                <span>Pág @ViewModel.NumeroPaginaprov</span>
                <button class="nav-btn" @onclick="() => SiguientePagina()">›</button>
            </div>
        </div>
    </div >
</body >

@code {
    void NavegarAgregarProveedor()
    {
        Navigation.NavigateTo($"/AgregarProveedor");
    }

    void NavegarActualizarProveedor(int id)
    {
        Navigation.NavigateTo($"/ActualizarProveedor/{id}");
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.CargarProveedores();
        ViewModel.MensajeError = "";
        ViewModel.MensajeExito = "";
    }

    /*Función que maneja el paginado de datos hacia atras*/

    protected async Task SiguientePagina()
    {
        if (ViewModel.NumeroPaginaprov < ViewModel.TotalDePaginasProv && ViewModel.FiltroBusquedaProv == true)
        {
            ViewModel.NumeroPaginaprov += 1;
            
            await ViewModel.BuscarProveedor(ViewModel.NumeroPaginaprov);
            return;
        }

        if (ViewModel.NumeroPaginaprov < ViewModel.TotalDePaginasProv)
        {
            ViewModel.NumeroPaginaprov += 1;
            await ViewModel.CargarProveedores();
        }

    }

    /*Función que maneja el paginado de datos hacia atras*/

    protected async Task PaginaAnterior()
    {
        if (ViewModel.NumeroPaginaprov > 1 && ViewModel.FiltroBusquedaProv == true)
        {
            ViewModel.NumeroPaginaprov -= 1;
            await ViewModel.BuscarProveedor(ViewModel.NumeroPaginaprov);
            return;
        }

        if (ViewModel.NumeroPaginaprov > 1)
        {
            ViewModel.NumeroPaginaprov -= 1;
            await ViewModel.CargarProveedores();
        }
    }

    private async Task ManejarTeclaEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ViewModel.BuscarProveedor(1);
        }
    }
}

    <style >

