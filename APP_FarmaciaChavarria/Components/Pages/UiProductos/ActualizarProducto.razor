@page "/actualizarProducto/{id:int}"

@using API_FarmaciaChavarria.Models
@using APP_FarmaciaChavarria.ViewModels
@inject ActualizarProductoViewModel ViewModel
@inject NavigationManager Navigation


@code {
    [Parameter]
    public int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // para llenar categorías y laboratorios
        await ViewModel.CargarProductoPorId(id);
        await ViewModel.CargarCategorias();
        await ViewModel.CargarLaboratorios();
    }

    private async Task NavegarInventario()
    {
        await ViewModel.ActualizarProducto();

        _ = Task.Run(async () =>
                    {
                        await Task.Delay(2500);
                        Navigation.NavigateTo($"/inventario");
                    });
       
    }

    // Variables y funciones necesarias para mostrar modals y obtener datos
    private bool ModalCategoriaVisible = false;

    private bool ModalLaboratorioVisible = false;

    private async Task SeleccionarCategoria(Categoria cat)
    {
        ViewModel.CategoriaId = cat.id_categoria;
        ViewModel.NombreCategoria = cat.nombre;
        ModalCategoriaVisible = false;
        ViewModel.NumeroPagina = 1;
        ViewModel.FiltroBusqueda = false;
        await ViewModel.CargarCategorias();
    }

    private async Task SeleccionarLaboratorio(Laboratorio lab)
    {
        ViewModel.LaboratorioId = lab.id_laboratorio;
        ViewModel.NombreLaboratorio = lab.nombre;
        ModalLaboratorioVisible = false;
        ViewModel.NumeroPaginaLab = 1;
        ViewModel.FiltroBusquedaLab = false;
        await ViewModel.CargarLaboratorios();
    }

    // Presionar enter en el input de búsqueda de categoría para llamar la función correspondiente
    private async Task ManejarTeclaPresionadaCat(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ViewModel.BuscarCategoria(1);
        }
    }

    // Presionar enter en el input de búsqueda de laboratorios para llamar la función correspondiente

    private async Task ManejarTeclaPresionadaLab(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ViewModel.NumeroPaginaLab = 1;
            await ViewModel.BuscarLaboratorios(1);
        }
    }

    /*Función que maneja el paginado de datos de categorías hacia adelante*/

    protected async Task SiguientePaginaCategoria()
    {
        if (ViewModel.NumeroPagina < ViewModel.TotalDePaginas && ViewModel.FiltroBusqueda == true)
        {
            ViewModel.NumeroPagina += 1;
            await ViewModel.BuscarCategoria(ViewModel.NumeroPagina);
            return;
        }

        if (ViewModel.NumeroPagina < ViewModel.TotalDePaginas)
        {
            ViewModel.NumeroPagina += 1;
            await ViewModel.CargarCategorias();
        }

    }

    /*Función que maneja el paginado de datos de categorías hacia atras*/

    protected async Task PaginaAnteriorCategoria()
    {
        if (ViewModel.NumeroPagina > 1 && ViewModel.FiltroBusqueda == true)
        {
            ViewModel.NumeroPagina -= 1;
            await ViewModel.BuscarCategoria(ViewModel.NumeroPagina);
            return;
        }

        if (ViewModel.NumeroPagina > 1)
        {
            ViewModel.NumeroPagina -= 1;
            await ViewModel.CargarCategorias();
        }
    }

    /*Función que maneja el paginado de datos de laboratorios hacia adelante*/

    protected async Task SiguientePaginaLaboratorio()
    {
        if (ViewModel.NumeroPaginaLab < ViewModel.TotalDePaginasLab && ViewModel.FiltroBusquedaLab == true)
        {
            ViewModel.NumeroPaginaLab += 1;
            await ViewModel.BuscarLaboratorios(ViewModel.NumeroPaginaLab);
            return;
        }

        if (ViewModel.NumeroPaginaLab < ViewModel.TotalDePaginasLab)
        {
            ViewModel.NumeroPaginaLab += 1;
            await ViewModel.CargarLaboratorios();
        }

    }

    /*Función que maneja el paginado de datos de laboratorios hacia atras*/

    protected async Task PaginaAnteriorLaboratorio()
    {
        if (ViewModel.NumeroPaginaLab > 1 && ViewModel.FiltroBusquedaLab == true)
        {
            ViewModel.NumeroPaginaLab -= 1;
            await ViewModel.BuscarLaboratorios(ViewModel.NumeroPaginaLab);
            return;
        }

        if (ViewModel.NumeroPaginaLab > 1)
        {
            ViewModel.NumeroPaginaLab -= 1;
            await ViewModel.CargarLaboratorios();
        }
    }

}

@if (!string.IsNullOrWhiteSpace(ViewModel.MensajeError))
{
        <div class="alert-error">
            <span>@ViewModel.MensajeError</span>
            <button @onclick="() => ViewModel.MensajeError = string.Empty">X</button>
        </div>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.MensajeExito))
{
        <div class="alert-success">
            <span>@ViewModel.MensajeExito</span>
            <button @onclick="() => ViewModel.MensajeExito = string.Empty">X</button>
        </div>
}

<div class="form-container">
    <div class="form-header">
        <div class="breadcrumbs">
            <strong>Inventario</strong> &gt; <strong>Lista de Medicamentos</strong> &gt;
            <span class="title">Actualizar Medicamento</span>
        </div>
        <button class="btn-actualizar" @onclick="() => NavegarInventario()">Actualizar</button>
    </div>

    <p class="note">
        *Todos los campos son obligatorios, excepto los mencionados como (opcionales).
    </p>

    <div class="form-flex">
        <div class="form-group">
            <label>Nombre <span style="color:red">*</span></label>
            <input type="text" @bind="ViewModel.Nombre" />
        </div>

        <div class="form-group">
            <label>ID del Medicamento</label>
            <input type="text" @bind="ViewModel.IdProducto" readonly />
        </div>

        <div class="form-group">
            <label>Categoría de Medicamento <span style="color:red">*</span></label> 
            <input readonly @onclick="()=>ModalCategoriaVisible = true" class="form-control"
                   value="@ViewModel.NombreCategoria" placeholder="Seleccionar Categoría" />
        </div>

        <div class="form-group">
            <label>Cantidad <span style="color:red">*</span></label>
            <input type="number" @bind="ViewModel.StockInput" />
        </div>

        <div class="form-group">
            <label>Stock Mínimo <span style="color:red">*</span></label>
            <input type="number" @bind="ViewModel.StockMinimoInput" />
        </div>

        <div class="form-group">
            <label>Laboratorio <span style="color:red">*</span></label> 
            <input readonly @onclick="()=>ModalLaboratorioVisible = true" class="form-control"
                   value="@ViewModel.NombreLaboratorio" placeholder="Seleccionar Laboratorio" />
        </div>

        <div class="form-group">
            <label>Fecha de Vencimiento <span style="color:red">*</span></label
            <input type="date" @bind="ViewModel.FechaVencimiento" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="form-group full-width">
            <label>Como Usar</label>
            <textarea rows="3" @bind="ViewModel.ComoUsar"></textarea>
        </div>

        <div class="form-group full-width">
            <label>Efectos Secundarios</label>
            <textarea rows="3" @bind="ViewModel.EfectosSecundarios"></textarea>
        </div>

        <button class="btn-actualizar" id="btnMobile" @onclick="ViewModel.ActualizarProducto">Actualizar</button>
    </div>
</div>


<!-- Modal Categorías -->
@if (ModalCategoriaVisible)
{
    <div class="modal-backdrop">
        <div class="modal-content">
            <h3>Seleccionar Categoría</h3>

            <div class="d-flex mb-2" style="gap: 8px;">
                <input type="text" class="form-control" placeholder="Buscar categoría..."
                       @bind="ViewModel.BusquedaCategoria"
                       @onkeydown="ManejarTeclaPresionadaCat" />

                <button class="btn btn-primary" @onclick="() => ViewModel.BuscarCategoria(1)">
                    Buscar
                </button>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th colspan="2">
                            <div class="row-flex">
                                <span>Nombre</span>
                                <span>Acción</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in ViewModel.Categorias)
                    {
                        <tr>
                            <td colspan="2">
                                <div class="row-flex">
                                    <span>@cat.nombre</span>
                                    <button class="btn btn-primary" @onclick="() => SeleccionarCategoria(cat)">
                                        Seleccionar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination">
                <span>Mostrando 1 - @ViewModel.TamañoDePagina resultados de @ViewModel.TotalDeCategorias</span>
                <div class="page-controls">
                    <button class="nav-btn" @onclick="() => PaginaAnteriorCategoria()">‹</button>
                    <span>Pág @ViewModel.NumeroPagina</span>
                    <button class="nav-btn" @onclick="() => SiguientePaginaCategoria()">›</button>
                </div>
            </div>

            <button class="btn btn-danger" @onclick="()=>ModalCategoriaVisible = false">Cerrar</button>
        </div>
    </div>
}

<!-- Modal Laboratorios -->
@if (ModalLaboratorioVisible)
{
    <div class="modal-backdrop">
        <div class="modal-content">
            <h3>Seleccionar Laboratorio</h3>

            <div class="d-flex mb-2" style="gap: 8px;">
                <input type="text" class="form-control" placeholder="Buscar laboratorio..."
                       @bind="ViewModel.BusquedaLaboratorio"
                       @onkeydown="ManejarTeclaPresionadaLab" />

                <button class="btn btn-primary" @onclick="() => ViewModel.BuscarLaboratorios(1)">
                    Buscar
                </button>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th colspan="2">
                            <div class="row-flex">
                                <span>Nombre</span>
                                <span>Acción</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lab in ViewModel.Laboratorios)
                    {
                        <tr>
                            <td colspan="2">
                                <div class="row-flex">
                                    <span>@lab.nombre</span>
                                    <button class="btn btn-primary" @onclick="() => SeleccionarLaboratorio(lab)">
                                        Seleccionar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination">
                <span>Mostrando 1 - @ViewModel.TamañoDePaginaLab resultados de @ViewModel.TotalDeLaboratorios</span>
                <div class="page-controls">
                    <button class="nav-btn" @onclick="() => PaginaAnteriorLaboratorio()">‹</button>
                    <span>Pág @ViewModel.NumeroPaginaLab</span>
                    <button class="nav-btn" @onclick="() => SiguientePaginaLaboratorio()">›</button>
                </div>
            </div>

            <button class="btn btn-danger" @onclick="()=>ModalLaboratorioVisible = false">Cerrar</button>
        </div>
    </div>
}


