@page "/reporteVentas"

@using APP_FarmaciaChavarria.ViewModels.Reportes
@using System.Globalization
@using Radzen
@using Radzen.Blazor
@using System.Diagnostics

@inject ReporteVentasViewModel ViewModel
@inject IJSRuntime JSRuntime


@if (!string.IsNullOrWhiteSpace(ViewModel.MensajeError))
{
    <div class="alert-error">
        <span>@ViewModel.MensajeError</span>
        <button @onclick="() => ViewModel.MensajeError = string.Empty">X</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.MensajeExito))
{
    <div class="alert-success">
        <span>@ViewModel.MensajeExito</span>
        <button @onclick="() => ViewModel.MensajeExito = string.Empty">X</button>
    </div>
}

<div class="reporte-container">

    <div class="encabezado">
        <div class="texto">
            <h2><strong>Reportes › Reporte de Ventas</strong></h2>
            <p class="subtitulo">Reporte relacionado a las ventas de la farmacia.</p>
        </div>
        <div class="contenedor-boton">
            <button class="btn-descargar" @onclick="ToggleOpcionesDescarga">
                📄 Descargar Reporte
            </button>

            @if (mostrarOpciones)
            {
                <div class="menu-opciones">
                    <button class="btn-opcion" @onclick="DescargarExcel">📊 Excel</button>
                    <button class="btn-opcion" @onclick="DescargarPdf">🧾 PDF</button>
                </div>
            }
        </div>
    </div>

    <div class="filtros">

        <div class="FechasMaxContainer">
            <div class="fechasContainer">
                <div>
                    <label>Fecha Inicio</label>
                    <input type="date" placeholder="Fecha Inicio" @bind=@ViewModel.PrimeraFecha  class="inputFecha"/>
                </div>

                <div>
                    <label>Fecha Final</label>
                    <input type="date" placeholder="Fecha final" @bind=ViewModel.UltimaFecha />
                </div>
            </div>
            <div class="filtrarFechaBtn">
                <button @onclick="() => ActualizarDatos()">Buscar</button>
            </div>
        </div>
        <div>
            <label>Grupo de Medicamentos</label>
            <select>
                <option>- Seleccionar Categorías -</option>
            </select>
        </div>
        <div>
            <label>Nombre de Usuario</label>
            <select @onchange="OnUserChanged" value="@ViewModel.UserId">
                <option value="0">- Seleccionar Usuario -</option>
                @foreach (var user in ViewModel.Usuarios)
                {
                    <option value="@user.id_usuario">@user.nombre</option>
                }
            </select>
        </div>
    </div>

    <!--Código de interfaz del gráfico de líneas-->
    <div class="contenido-reporte">
        <div class="grafico" >
            <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="@smooth" Name="smooth"></RadzenCheckBox>
                            <RadzenLabel Text="Smooth" Component="smooth" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="@showDataLabels" Name="dataLabels"></RadzenCheckBox>
                            <RadzenLabel Text="Show Data Labels" Component="dataLabels" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="@showMarkers" Name="markers"></RadzenCheckBox>
                            <RadzenLabel Text="Show Markers" Component="markers" />
                        </RadzenStack>

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="@sharedTooltip" Name="sharedToltip"></RadzenCheckBox>
                            <RadzenLabel Text="Shared Tooltip" Component="sharedTooltip"/>
                        </RadzenStack>

                    </RadzenStack>
                </RadzenCard>
                <RadzenChart>
                    <RadzenChartTooltipOptions Shared="@sharedTooltip" />

                    <RadzenLineSeries Smooth="@smooth" Data="@ViewModel.RevenueData" CategoryProperty="Date" Title="@ViewModel.Año.ToString()" ValueProperty="Revenue" >
                        <RadzenMarkers Visible="@showMarkers" MarkerType="MarkerType.Circle" />
                        <RadzenSeriesDataLabels Visible="@showDataLabels"/>
                    </RadzenLineSeries>

                    <RadzenCategoryAxis Padding="15" LabelRotation="90"/>

                    <RadzenValueAxis Formatter="@FormatAsNIO">

                        <RadzenGridLines Visible="true" />

                        <RadzenAxisTitle Text="Ganancias en córdobas" />
                    </RadzenValueAxis>

                </RadzenChart>
            </RadzenStack>
        </div>

        <div class="tabla">
            <table>
                <thead>
                    <tr>
                        <th>Orden ID</th>
                        <th>Fecha y Hora</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewModel.Facturas)
                    {
                        <tr>
                            <td>@item.id_factura</td>
                            <td>@item.fecha_venta</td>
                            <td>C$ @item.total</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="grafico-reporte-export" style="position: absolute; top: -9999px; width: 900px; height: 550px; display:none;">
    <RadzenChart>
        <RadzenChartTooltipOptions Shared="@sharedTooltip" />
        <RadzenLineSeries Smooth="@smooth" Data="@ViewModel.RevenueData" CategoryProperty="Date" Title="@ViewModel.Año.ToString()" ValueProperty="Revenue">
            <RadzenMarkers Visible="@showMarkers" MarkerType="MarkerType.Circle" />
            <RadzenSeriesDataLabels Visible="@showDataLabels" />
        </RadzenLineSeries>

        <RadzenCategoryAxis Padding="20" LabelRotation="20"/>
        <RadzenValueAxis Formatter="@FormatAsNIO">
            <RadzenGridLines Visible="true" />
            <RadzenAxisTitle Text="Ganancias en córdobas" />
        </RadzenValueAxis>
    </RadzenChart>
</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.CargarUsuarios();
        await ActualizarDatos();
    }

    bool smooth = false;
    bool sharedTooltip = true;
    bool showDataLabels = false;
    bool showMarkers = true;

    private string FormatAsNIO(object value)
    {
        // Crear cultura para Nicaragua
        var culture = CultureInfo.CreateSpecificCulture("es-NI");

        // Formato con símbolo de córdoba (C$), sin decimales (0)
        return ((double)value).ToString("C0", culture);
    }

    protected async Task ActualizarDatos()
    {
        await ViewModel.CargarVentasGrafico();
        await ViewModel.CargarVentas();
    }

    private async Task OnUserChanged(ChangeEventArgs e)
    {
        ViewModel.UserId = Convert.ToInt32(e.Value);
        await ActualizarDatos(); // Llama a tu método para cargar datos
    }


    // Funciones para la descarga de reporte en excel o pdf

    private bool mostrarOpciones = false;

    private void ToggleOpcionesDescarga()
    {
        mostrarOpciones = !mostrarOpciones;
    }

    private async Task DescargarExcel()
    {
        mostrarOpciones = false;

        var fileBytes = ViewModel.GenerarExcelYDescargar(ViewModel.RevenueData);
        var nombreArchivo = $"ReporteDeVentas_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

        await JSRuntime.InvokeVoidAsync("descargarExcel", fileBytes, nombreArchivo);
    }

    private async Task<byte[]> CapturarGraficoComoImagen()
    {
        var imageDataUrl = await JSRuntime.InvokeAsync<string>("capturarGrafico", "grafico-reporte-export");

        if (string.IsNullOrEmpty(imageDataUrl))
            return null;

        // Convertir Data URL a bytes
        var base64Data = imageDataUrl.Split(',')[1];
        return Convert.FromBase64String(base64Data);
    }

    private async Task DescargarPdf()
    {
        mostrarOpciones = false;

        var imagenGrafico = await CapturarGraficoComoImagen();

        Debug.WriteLine($"Imagen: {imagenGrafico}");
        var pdfBytes = ViewModel.GenerarPdf(ViewModel.RevenueData, imagenGrafico);

        if (pdfBytes != null)
        {
            var nombreArchivo = $"ReporteDeVentas_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JSRuntime.InvokeVoidAsync("descargarPdf", pdfBytes, nombreArchivo); // podemos usar la misma función JS
        }
    }
}
