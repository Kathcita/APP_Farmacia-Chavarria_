@page "/medicamentosPorCaducar"

@using APP_FarmaciaChavarria.ViewModels.Reportes

@inject MedicamentosPorCaducarViewModel ViewModel


<div class="reporte-container">
    <div class="encabezado">
        <div class="texto">
            <h2><strong>Reportes › Medicamentos Escasos</strong></h2>
            <p class="subtitulo">Reporte relacionado a los productos próximos a caducar. (Período de 3 meses)</p>
        </div>
    </div>

    <div class="tabla">
        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Laboratorio</th>
                    <th>Stock</th>
                    <th>Fecha de Vencimiento</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < ViewModel.ProductosPorCaducar.Count; i++)
                {
                    <tr>
                        <td>@ViewModel.ProductosPorCaducar[i].Nombre</td>
                        <td>@ViewModel.ProductosPorCaducar[i].CategoriaNombre</td>
                        <td>@ViewModel.ProductosPorCaducar[i].LaboratorioNombre</td>
                        <td>@ViewModel.ProductosPorCaducar[i].Stock</td>
                        <td>@ViewModel.ProductosPorCaducar[i].FechaVencimiento</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <div class="page-controls">
                <button class="nav-btn" @onclick="() => PaginaAnterior()">‹</button>
                <span>Pág @ViewModel.NumeroPagina</span>
                <button class="nav-btn" @onclick="() => SiguientePagina()">›</button>
            </div>
        </div>
    </div>

</div>


@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.CargarProductos();
    }

    protected async Task SiguientePagina()
    {
        if (ViewModel.NumeroPagina < ViewModel.TotalDePaginas)
        {
            ViewModel.NumeroPagina += 1;
            await ViewModel.CargarProductos();
        }

    }

    /*Función que maneja el paginado de datos hacia atras*/

    protected async Task PaginaAnterior()
    {
        if (ViewModel.NumeroPagina > 1)
        {
            ViewModel.NumeroPagina -= 1;
            await ViewModel.CargarProductos();
        }
    }
}
