@page "/login"
@using FarmaciaChavarria.ViewModels
@inject LoginViewModel ViewModel

<div class="login-container">
    <div class="login-card">
        <img src="farmaciachavarialogo.jpg" alt="Farmacia Chavarría" class="logo" />

        <h2 class="login-title">LOGIN</h2>
        <input type="text" placeholder="Ingrese su usuario"
               class="login-input"
               @bind="ViewModel.Usuario" />

        <h2 class="login-title">PIN</h2>
        <input type="password" placeholder="Ingrese su PIN"
               class="login-input"
               @bind="ViewModel.Contraseña" />

        <button class="login-button" @onclick="ViewModel.IniciarSesion">Entrar</button>

        <div class="forgot-password">¿Olvidó su contraseña? <span class="emoji">😊</span></div>

        @if (!string.IsNullOrEmpty(ViewModel.Mensaje))
        {
            <p class="message">@ViewModel.Mensaje</p>
        }
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: radial-gradient(circle, rgba(63,94,251,1) 0%, rgba(236,252,70,1) 100%);
    }

    .login-card {
        background-color: white;
        border-radius: 2rem;
        padding: 2rem;
        width: 90%;
        max-width: 350px;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .logo {
        max-width: 120px;
        margin-bottom: 1.5rem;
    }

    .login-title {
        font-weight: bold;
        font-size: 1.2rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }

    .login-input {
        width: 100%;
        padding: 0.5rem;
        font-size: 1rem;
        margin-bottom: 1rem;
        border-radius: 0.5rem;
        border: 1px solid #ccc;
        text-align: center;
    }

    .login-button {
        width: 100%;
        padding: 0.75rem;
        font-size: 1.1rem;
        font-weight: bold;
        color: white;
        background-color: #00aaff;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        margin-bottom: 1rem;
        transition: background 0.3s;
    }

        .login-button:hover {
            background-color: #0088cc;
        }

    .forgot-password {
        font-size: 0.9rem;
        color: #666;
    }

    .emoji {
        font-size: 1.2rem;
    }

    .message {
        font-size: 1rem;
        font-weight: bold;
        color: red;
    }
</style>
