@page "/ActualizarUsuario/{Id:int}"
@using APP_FarmaciaChavarria.Models.ModelsDTO
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Actualizar Usuario</h3>

@if (!string.IsNullOrEmpty(Mensaje))
{
    <div class="alert-success">
        <span>@Mensaje</span>
        <button @onclick="() => Mensaje = string.Empty">X</button>
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert-error">
        <span>@Error</span>
        <button @onclick="() => Error = string.Empty">X</button>
    </div>
}

@if (usuario != null)
{
    <EditForm Model="usuario" OnValidSubmit="Actualizar" class="formulario">
        <div class="form-group">
            <label>Nombre:</label>
            <input class="form-control" @bind="usuario.nombre" />
        </div>

        <div class="form-group">
            <label>PIN:</label>
            <input class="form-control" @bind="usuario.pin" maxlength="4" />
        </div>

        <div class="form-group">
            <label>Rol:</label>
            <select class="form-control" @bind="usuario.rol">
                <option value="Administrador">Administrador</option>
                <option value="Empleado">Empleado</option>
            </select>
        </div>

        <button class="btn btn-success" type="submit">Actualizar Detalles</button>
    </EditForm>
}
else
{
    <p>Cargando usuario...</p>
}

@code {
    [Parameter] public int Id { get; set; }

    public string Mensaje = "";
    public string Error = "";

    private UsuarioDTO usuario;

    protected override async Task OnInitializedAsync()
    {
        usuario = await Http.GetFromJsonAsync<UsuarioDTO>($"api/Usuarios/{Id}");
        Mensaje = "";
        Error = "";
    }

    private async Task Actualizar()
    {

        if (usuario.nombre == "")
        {
            Error = "El campo nombre no puede estar vacío";
            return;
        }

        if (usuario.pin.ToString() == "")
        {
            Error = "El campo pin no puede estar vacío";
            return;
        }

        if (usuario.pin.ToString().Length != 4)
        {
            Error = "El campo pin debe contener 4 dígitos";
            return;
        }

        var resp = await Http.PutAsJsonAsync($"api/Usuarios/{usuario.id_usuario}", usuario);
        if (resp.IsSuccessStatusCode)
        {
            Mensaje = "Usuario actualizado exitosamente";
            Navigation.NavigateTo("/RegistroUsuario");
        }
    }
}

    <style>
    .formulario{
        display:flex;
        justify-content:center;
        flex-direction: column;
    }

    .btn{
        margin:10px;
    }

    /*Estilos para mensaje de error*/

    .alert-error {
        position: absolute;
        background-color: #f44336;
        color: white;
        padding: 12px 20px;
        border-radius: 5px;
        position: relative;
        margin-bottom: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        animation: fadein 0.3s ease-in-out;
    }

        .alert-error button {
            background: transparent;
            border: none;
            color: white;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
        }

    @@keyframes fadein {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    /*Estilos para mensaje de éxito*/
    .alert-success {
        position: absolute;
        background-color: #4CAF50;
        color: white;
        padding: 12px 20px;
        border-radius: 5px;
        position: relative;
        margin-bottom: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        animation: fadein 0.3s ease-in-out;
    }

        .alert-success button {
            background: transparent;
            border: none;
            color: white;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
        }

    @@keyframes fadein {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }
    </style>