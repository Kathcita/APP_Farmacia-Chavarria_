@page "/"

@using APP_FarmaciaChavarria.Models.AuthRequest
@using APP_FarmaciaChavarria.Service
@using APP_FarmaciaChavarria.ViewModels.Reportes
@using System.Diagnostics
@using System.Globalization
@using System.Net.Http.Headers
@using CommunityToolkit.Maui.Storage
@using Microsoft.Maui.Controls.PlatformConfiguration

@inject NavigationManager Navigation
@inject DashboardViewModel ViewModel
@inject IJSRuntime JSRuntime
@inject TokenHandlerService TokenHandler



@if (!string.IsNullOrWhiteSpace(ViewModel.MensajeError))
{
    <div class="alert-error">
        <span>@ViewModel.MensajeError</span>
        <button @onclick="() => ViewModel.MensajeError = string.Empty">X</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ViewModel.MensajeExito))
{
    <div class="alert-success">
        <span>@ViewModel.MensajeExito</span>
        <button @onclick="() => ViewModel.MensajeExito = string.Empty">X</button>
    </div>
}

@if(ViewModel.Cargando){
    <p>Cargando información...</p>
} else{
    <div class="dashboard-container">
        <h1>Dashboard</h1>
        <p class="dashboard-description">Una rápida descripción de los datos del inventario</p>

        <div class="contenedor-boton">
            <button class="btn-download" @onclick="ToggleOpcionesDescarga">Descargar Reporte</button>

            @if (mostrarOpciones)
            {
                <div class="menu-opciones">
                    <button class="btn-opcion" @onclick="DescargarExcel">📊 Excel</button>
                    <button class="btn-opcion" @onclick="DescargarPdf">🧾 PDF</button>
                </div>
            }
        </div>

        <div class="dashboard-grid">
            <div class="card">
                <h2>@ViewModel.DashboardData.EstadoInventario</h2>
                <p>Estado del Inventario</p>
                <button @onclick=NavegarInventario>Ver Detalles del Reporte</button>
            </div>
            <div class="card">
                <h2>C$ @ViewModel.DashboardData.VentasDelMes</h2>
                <p>Ganancia - @DateTime.Now.ToString("MMM - yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
                <button @onclick=NavegarReporteVentas>Ver Detalles del Reporte</button>
            </div>
            <div class="card">
                <h2>@ViewModel.DashboardData.MedicamentosDisponibles</h2>
                <p>Medicamentos Disponibles</p>
                <button @onclick=NavegarInventario>Visitar Inventario</button>
            </div>
            <div class="card">
                <h2>@ViewModel.DashboardData.MedicamentosEscasos</h2>
                <p>Medicamentos Escasos</p>
                <button class="btn-danger" @onclick=NavegarAProductosEscasos>Revisar Ahora</button>
            </div>
        </div>

        <div class="dashboard-sections">
            <div>
                <h4>Inventario</h4>
                <p>Número Total de Medicamentos: @ViewModel.DashboardData.MedicamentosTotales</p>
                <p>Categorías: @ViewModel.DashboardData.CategoriasTotales</p>
            </div>
            <div>
                <h4>Mi Farmacia</h4>
                <p>Número Total de Proveedores: @ViewModel.DashboardData.TotalProveedores</p>
                <p>Total de Usuarios: @ViewModel.DashboardData.TotalUsuarios</p>
            </div>
            <div>
                <h4>Informe Rápido</h4>
                <p>Medicamentos Vendidos: @ViewModel.DashboardData.TotalMedicamentosVendidosDelMes</p>
                <p>Facturas Generadas: @ViewModel.DashboardData.TotalFacturasDelMes</p>
            </div>
            <div>
                <h4>Producto Popular</h4>
                <p>@ViewModel.DashboardData.ProductoMasVendido - Comprado con Frecuencia</p>
            </div>
        </div>
    </div>

    <div id="grafico-reporte-export">
        <div class="dashboard-grid">
            <div class="card">
                <h2>@ViewModel.DashboardData.EstadoInventario</h2>
                <p>Estado del Inventario</p>
                <button @onclick=NavegarInventario>Ver Detalles del Reporte</button>
            </div>
            <div class="card">
                <h2>C$ @ViewModel.DashboardData.VentasDelMes</h2>
                <p>Ganancia - @ObtenerMesAbreviado() @date.Year</p>
                <button @onclick=NavegarReporteVentas>Ver Detalles del Reporte</button>
            </div>
            <div class="card">
                <h2>@ViewModel.DashboardData.MedicamentosDisponibles</h2>
                <p>Medicamentos Disponibles</p>
                <button @onclick=NavegarInventario>Visitar Inventario</button>
            </div>
            <div class="card">
                <h2>@ViewModel.DashboardData.MedicamentosEscasos</h2>
                <p>Medicamentos Escasos</p>
                <button class="btn-danger" @onclick=NavegarAProductosEscasos>Revisar Ahora</button>
            </div>
        </div>

        <div class="dashboard-sections">
            <div>
                <h4>Inventario</h4>
                <p>Número Total de Medicamentos: @ViewModel.DashboardData.MedicamentosTotales</p>
                <p>Categorías: @ViewModel.DashboardData.CategoriasTotales</p>
            </div>
            <div>
                <h4>Mi Farmacia</h4>
                <p>Número Total de Proveedores: @ViewModel.DashboardData.TotalProveedores</p>
                <p>Total de Usuarios: @ViewModel.DashboardData.TotalUsuarios</p>
            </div>
            <div>
                <h4>Informe Rápido</h4>
                <p>Medicamentos Vendidos: @ViewModel.DashboardData.TotalMedicamentosVendidosDelMes</p>
                <p>Facturas Generadas: @ViewModel.DashboardData.TotalFacturasDelMes</p>
            </div>
            <div>
                <h4>Producto Popular</h4>
                <p>@ViewModel.DashboardData.ProductoMasVendido - Comprado con Frecuencia</p>
            </div>
        </div>
    </div>
}
<style>
    body {
    font-family: 'Segoe UI', sans-serif;
    background-color: #f1f6fc;
    margin: 0;
    padding: 0;
    }

    .dashboard-container {
    padding: 2rem;
    }

    h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #1a1a1a;
    }

    .dashboard-description {
    margin-bottom: 1rem;
    color: #4a4a4a;
    }

    .btn-download {
    background-color: #6c63ff;
    color: white;
    border: none;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 1.5rem;
    }

    .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
    }

    .card {
    background-color: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;
    transition: all 0.3s ease;
    }

    .card h2 {
    margin: 0;
    font-size: 1.8rem;
    color: #1a1a1a;
    }

    .card p {
    margin: 0;
    font-size: 0.95rem;
    color: #666;
    }

    .card button {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background-color: #f1f1f1;
    }

    .card .btn-danger {
    background-color: #f87171;
    color: white;
    }

    .dashboard-sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    color: #222;
    font-size: 0.95rem;
    }

    /*Diseños para el botón de descargar reporte y las opciones*/
    .contenedor-boton {
    position: relative;
    display: inline-block;
    }

    .btn-descargar {
    background-color: #0078d7;
    color: white;
    padding: 8px 12px;
    border: none;
    cursor: pointer;
    border-radius: 5px;
    }

    .menu-opciones {
    position: absolute;
    top: 60%;
    left: 0;
    background-color: white;
    border: 1px solid #ccc;
    padding: 6px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    z-index: 1000;
    border-radius: 6px;
    margin-top: 4px;
    }

    .btn-opcion {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 6px 10px;
    text-align: left;
    cursor: pointer;
    color: #333;
    }

    .btn-opcion:hover {
    background-color: #f0f0f0;
    }

    /*Gráfico para la captura de pantalla*/

    #grafico-reporte-export {
    position: absolute;
    top: -9999px;
    width: 1200px;
    height: 550px;
    display: none;
    }

    /*Estilos para mensaje de error*/

    .alert-error {
    position: absolute;
    background-color: #f44336;
    color: white;
    padding: 12px 20px;
    border-radius: 5px;
    position: relative;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    animation: fadein 0.3s ease-in-out;
    }

    .alert-error button {
    background: transparent;
    border: none;
    color: white;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
    }

    @@keyframes fadein {
    from {
    opacity: 0;
    }

    to {
    opacity: 1;
    }
    }

    /*Estilos para mensaje de éxito*/
    .alert-success {
    position: absolute;
    background-color: #4CAF50;
    color: white;
    padding: 12px 20px;
    border-radius: 5px;
    position: relative;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    animation: fadein 0.3s ease-in-out;
    }

    .alert-success button {
    background: transparent;
    border: none;
    color: white;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
    }

    @@keyframes fadein {
    from {
    opacity: 0;
    }

    to {
    opacity: 1;
    }
    }
</style>

@code {
    private DateTime date = DateTime.Now;

    protected override void OnInitialized()
    {
        var token = Preferences.Default.Get("JwtToken", string.Empty);
        var createdAtStr = Preferences.Default.Get<string>("TokenCreatedAt", string.Empty);
        UserStatic.Rol = Preferences.Default.Get<string>("RolUser", string.Empty);

        if (!string.IsNullOrEmpty(token) && DateTime.TryParse(createdAtStr, out var createdAt))
        {
            TokenHandler.SetToken(token);

            if ((DateTime.UtcNow - createdAt).TotalMinutes < 180)
            {
                // Mantener Sesión iniciada
            }
            else
            {
                Navigation.NavigateTo("/login", true);
                // Ir a login
            }
        }
        else
        {
            Navigation.NavigateTo("/login", true);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.CargarDatos();
        ViewModel.MensajeExito = "";
        ViewModel.MensajeError = "";
    }

    private void NavegarAProductosEscasos()
    {
        Navigation.NavigateTo("/medicamentosEscasos");
    }

    private void NavegarInventario()
    {
        Navigation.NavigateTo("/inventario");
    }

    private void NavegarReporteVentas()
    {
        Navigation.NavigateTo("/reporteVentas");
    }

    // Funciones para la descarga de reporte en excel o pdf

    private bool mostrarOpciones = false;

    private void ToggleOpcionesDescarga()
    {
        mostrarOpciones = !mostrarOpciones;
    }

    private async Task DescargarExcel()
    {
        mostrarOpciones = false;

        var fileBytes = ViewModel.GenerarExcelYDescargar(ViewModel.DashboardData);
        var nombreArchivo = $"ReporteGeneral_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

        try
        {
            if (DeviceInfo.Current.Platform == DevicePlatform.Android ||
    DeviceInfo.Current.Platform == DevicePlatform.iOS)
            {
                var result = await FileSaver.Default.SaveAsync(
            nombreArchivo,
            new MemoryStream(fileBytes),
            new CancellationToken());

            }
            else
            {
                await JSRuntime.InvokeVoidAsync("descargarExcel", fileBytes, nombreArchivo);
            }

            ViewModel.MensajeExito = "El archivo se guardó exitosamente";
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error al guardar archivo: {ex.Message}");
            ViewModel.mensajeError = ex.Message;
        }
    }

    private async Task<byte[]> CapturarGraficoComoImagen()
    {
        var imageDataUrl = await JSRuntime.InvokeAsync<string>("capturarGrafico", "grafico-reporte-export");

        if (string.IsNullOrEmpty(imageDataUrl))
            return null;

        // Convertir Data URL a bytes
        var base64Data = imageDataUrl.Split(',')[1];
        return Convert.FromBase64String(base64Data);
    }

    private async Task DescargarPdf()
    {
        mostrarOpciones = false;

        var imagenGrafico = await CapturarGraficoComoImagen();
        Debug.WriteLine($"Imagen {imagenGrafico}");

        if (DeviceInfo.Current.Platform == DevicePlatform.Android ||
       DeviceInfo.Current.Platform == DevicePlatform.iOS)
        {
            var pdfBytes = ViewModel.GenerarPdfConPdfSharp(ViewModel.DashboardData, imagenGrafico);

            if (pdfBytes != null)
            {
                var nombreArchivo = $"ReporteGeneral_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
                
                var result = await FileSaver.Default.SaveAsync(
            nombreArchivo,
            new MemoryStream(pdfBytes),
            new CancellationToken());

                ViewModel.MensajeExito = "El archivo se guardó con éxito";
            }
        }
        else
        {
            var pdfBytes = ViewModel.GenerarPdf(ViewModel.DashboardData, imagenGrafico);

            if (pdfBytes != null)
            {
                var nombreArchivo = $"ReporteGeneral_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
                await JSRuntime.InvokeVoidAsync("descargarPdf", pdfBytes, nombreArchivo); // podemos usar la misma función JS
                ViewModel.MensajeExito = "El archivo se guardó con éxito";
            }
        }
        


    }

    private static string ObtenerMesAbreviado()
    {
        // Cultura española para obtener "Ene", "Feb", etc.
        CultureInfo cultura = new CultureInfo("es-ES");
        string mesAbreviado = DateTime.Now.ToString("MMM", cultura);

        // Opción: convertir a mayúscula inicial si es necesario
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(mesAbreviado);
    }
}
